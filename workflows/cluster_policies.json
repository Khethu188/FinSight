
{
  "cluster_policies": {
    "pipeline_job_cluster": {
      "description": "Cost-optimized cluster for daily pipeline jobs",
      "spark_version": "14.3.x-scala2.12",
      "node_type_id": "m5.xlarge",
      "driver_node_type_id": "m5.xlarge",
      "num_workers": 2,
      "autoscale": {
        "min_workers": 1,
        "max_workers": 4
      },
      "aws_attributes": {
        "instance_profile_arn": "arn:aws:iam::ACCOUNT_ID:instance-profile/financial-data-platform-dev-databricks-role",
        "availability": "SPOT_WITH_FALLBACK",
        "zone_id": "af-south-1a",
        "first_on_demand": 1,
        "spot_bid_price_percent": 100
      },
      "spark_conf": {
        "spark.databricks.delta.optimizeWrite.enabled": "true",
        "spark.databricks.delta.autoCompact.enabled": "true",
        "spark.databricks.delta.schema.autoMerge.enabled": "true",
        "spark.sql.adaptive.enabled": "true",
        "spark.sql.adaptive.coalescePartitions.enabled": "true",
        "spark.databricks.io.cache.enabled": "true"
      },
      "spark_env_vars": {
        "ENVIRONMENT": "dev",
        "PROJECT": "financial-data-platform"
      },
      "custom_tags": {
        "Project": "financial-data-platform",
        "Environment": "dev",
        "CostCenter": "data-engineering",
        "ManagedBy": "databricks-workflow"
      },
      "autotermination_minutes": 15,
      "enable_elastic_disk": true,
      "data_security_mode": "SINGLE_USER"
    },
    "gold_heavy_cluster": {
      "description": "Larger cluster for Gold aggregations and anomaly detection",
      "spark_version": "14.3.x-scala2.12",
      "node_type_id": "m5.2xlarge",
      "driver_node_type_id": "m5.2xlarge",
      "num_workers": 3,
      "autoscale": {
        "min_workers": 2,
        "max_workers": 6
      },
      "aws_attributes": {
        "instance_profile_arn": "arn:aws:iam::ACCOUNT_ID:instance-profile/financial-data-platform-dev-databricks-role",
        "availability": "SPOT_WITH_FALLBACK",
        "first_on_demand": 1,
        "spot_bid_price_percent": 100
      },
      "spark_conf": {
        "spark.databricks.delta.optimizeWrite.enabled": "true",
        "spark.databricks.delta.autoCompact.enabled": "true",
        "spark.sql.adaptive.enabled": "true",
        "spark.databricks.io.cache.enabled": "true",
        "spark.sql.shuffle.partitions": "200"
      },
      "custom_tags": {
        "Project": "financial-data-platform",
        "Environment": "dev",
        "CostCenter": "data-engineering",
        "ClusterTier": "heavy"
      },
      "autotermination_minutes": 20,
      "enable_elastic_disk": true,
      "data_security_mode": "SINGLE_USER"
    },
    "lightweight_cluster": {
      "description": "Minimal cluster for quality checks and alerting",
      "spark_version": "14.3.x-scala2.12",
      "node_type_id": "m5.large",
      "driver_node_type_id": "m5.large",
      "num_workers": 1,
      "aws_attributes": {
        "availability": "SPOT",
        "spot_bid_price_percent": 100
      },
      "spark_conf": {
        "spark.databricks.delta.optimizeWrite.enabled": "true"
      },
      "custom_tags": {
        "Project": "financial-data-platform",
        "ClusterTier": "lightweight"
      },
      "autotermination_minutes": 10,
      "enable_elastic_disk": true,
      "data_security_mode": "SINGLE_USER"
    }
  }
}

